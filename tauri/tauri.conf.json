{
  "build": {
    "before": ["build"],
    "args": ["--remote-settings=off"]
  },
  "package": {
    "productName": "HiPod",
    "version": "1.0.0",
    "installerToken": "",
    "longDescription": "Aplicación de escritorio para estación de pruebas HiPot",
    "copyright": "2025 HiPot",
    "debrisRemoval": true
  },
  "tauri": {
    "active": true,
    "category": "dev tools",
    "bundleIdentifier": "com.hipot.app",
    "productName": "HiPod",
    "version": "1.0.0",
    "copyright": "2025 HiPot",
    "requiredFeatures": [],
    "skipSigning": false,
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "nsis": {
          "installMode": "both",
          "installerIcon": "icons/icon.ico",
          "languages": ["Spanish", "English"],
          "displayLanguageSelector": true,
          "startMenuShortcut": true,
          "desktopShortcut": true
        }
      }
    },
    "window": {
      "shadow": false,
      "transparent": false,
      "alwaysOnTop": false,
      "visible": true,
      "skipTaskbar": false,
      "focus": true,
      "fullscreen": false,
      "resizable": true,
      "minimizable": true,
      "maximizable": true,
      "closable": true,
      "frame": true,
      "position": "center",
      "size": [1280, 800],
      "minSize": [800, 600],
      "maxSize": [2560, 1600],
      "title": "HiPot - Estación de Pruebas"
    },
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hector1516/HiPotApp/releases/latest/download/latest.json"
      ],
      "pubkey": "PEGAR_AQUI_LA_CLAVE_PUBLICA_DEL_UPDATER",
      "windows": {
        "installMode": "both"
      }
    }
  }
}
