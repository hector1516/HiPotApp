{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiPotApp",
  "version": "1.0.3",
  "identifier": "com.hipot.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HiPot - Estación de Pruebas",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../binaries/hipot-backend-x86_64-pc-windows-msvc.exe"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hector1516/HiPotApp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGN0ZCMzY2MDU4MTk5MTEKUldRUm1ZRUZack4vUDhybjlQenJXR24xalYrYnhma3Y3YUJLa3EzVGNKa3o3RzlJY0ZWUVVNMSsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
